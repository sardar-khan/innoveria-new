# Email configuration for the contact-form confirmation (api/lead.js).
# Set these as Environment Variables in the Vercel project (Settings > Environment
# Variables). Never commit real values; .env and mail.txt are gitignored.
#
# Sending mailbox (Namecheap / cPanel SMTP for innovariatech.space):
SMTP_HOST=mail.innovariatech.space
SMTP_PORT=465
SMTP_USER=info@innovariatech.space
SMTP_PASS=your-mailbox-password-here

# The mail server presents a shared-hosting wildcard certificate (*.web-hosting.com)
# rather than one for mail.innovariatech.space. This is the hostname the cert
# actually covers, used only for TLS validation (SNI). If the site is migrated to a
# different hosting server, update this to the new server's *.web-hosting.com name
# (find it with: reverse DNS of the SMTP host's IP). Leave blank to fall back to
# rejectUnauthorized:false, which sends but skips certificate validation.
SMTP_TLS_SERVERNAME=premium293-3.web-hosting.com

# From header on outgoing mail, and where the internal "new lead" notification
# goes. LEAD_NOTIFY_TO accepts a comma-separated list for multiple recipients.
MAIL_FROM=Innovaria Tech <info@innovariatech.space>
LEAD_NOTIFY_TO=info@innovariatech.space, what.why.if@gmail.com

# --- Existing leads-portal config (unchanged, see README "Leads admin portal") ---
